# Meruit environment. Copy to .env.local and fill in. Never commit .env.local.
# Run `npm run keys` to generate every wallet key and the two random secrets.

NEXT_PUBLIC_NETWORK=mainnet          # mainnet | devnet
NEXT_PUBLIC_SITE_URL=https://meruit.vercel.app
NEXT_PUBLIC_E2E=                     # set to 1 on preview builds only, registers the test wallet

SOLANA_RPC_MAINNET=                  # Helius mainnet URL (helius.dev, free)
SOLANA_RPC_DEVNET=                   # Helius devnet URL

MERUIT_FEE_PAYER_KEY=                # base58 secret, hot key, ~0.05 SOL mainnet for rent float and fees
MERUIT_RECEIVER_AUTHORIZER_KEY=      # base58 secret, signs settlement vouchers, needs no funds
MERUIT_PAY_TO=                       # seller payout wallet public key (your Phantom)
MERUIT_DEVNET_SPONSOR_KEY=           # devnet key holding devnet SOL + USDC for the judge pocket
MERUIT_BUYER_TEST_KEY=               # base58 secret, test buyer used by scripts only, never by the web app
MERUIT_SELLER_TEST_KEY=              # base58 secret of the placeholder payout wallet generated by keys.ts

MERUIT_RATE_ATOMIC_PER_MIN=10000     # $0.01 per audio minute (6-decimal USDC)
MERUIT_MAX_JOB_ATOMIC=250000         # $0.25 max per job
MERUIT_MAX_WALLET_DAY_ATOMIC=1000000 # $1.00 max per wallet per day
MERUIT_WITHDRAW_DELAY_SECS=900
MERUIT_LIVE=on                       # kill switch: set to off to refuse new jobs
MERUIT_SABOTAGE=                     # empty in production, see lib/sabotage.ts
MERUIT_SIGNING_SECRET=               # HMAC secret for preview sabotage headers

GROQ_API_KEY=                        # console.groq.com, free
AURORA_API_KEY=                      # studio.aurora.dev
AURORA_BASE_URL=https://intents-api.aurora.dev
AURORA_CONNECT_BASE_URL=             # from the Aurora team, optional
ONECLICK_JWT=                        # partners.near-intents.org, optional

KV_REST_API_URL=                     # Upstash Redis via Vercel Marketplace
MERUIT_STORE=                        # set to memory for local dev only, never in production
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=               # Vercel Blob

CRON_SECRET=                         # bearer for /api/cron/sweep
